@model Clinica.Models.HorarioModel

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card-clinica">

                <h2 class="titulo-clinica text-center mb-4">
                    Eliminar Horario
                </h2>

                <div class="alert alert-warning">

                    <strong>Confirmación:</strong>

                    <p class="mb-0 mt-2">
                        Está a punto de eliminar el siguiente horario.
                    </p>

                </div>

                <div class="border rounded p-3 bg-light mb-4">

                    <div class="mb-2">

                        <strong>Médico:</strong>

                        @Model.identificacionMedico

                    </div>

                    <div class="mb-2">

                        <strong>Día:</strong>

                        @Model.diaSemana

                    </div>

                    <div class="mb-2">

                        <strong>Hora Inicio:</strong>

                        @Model.horaInicio

                    </div>

                    <div>

                        <strong>Hora Fin:</strong>

                        @Model.horaFin

                    </div>

                </div>

                <form method="post">

                    <input asp-for="identificacionMedico"
                           type="hidden" />

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-danger">
                            Confirmar Eliminación
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>