@model Clinica.Models.EmpleadoModel

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card-clinica">

                <h2 class="titulo-clinica text-center mb-4">
                    Editar Empleado
                </h2>

                <form method="post">

                    <input asp-for="identificacion" type="hidden" />

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="identificacion" class="form-label">
                                Identificación
                            </label>

                            <input asp-for="identificacion"
                                   class="form-control bg-light"
                                   readonly />

                            <small class="text-muted">
                                La identificación no puede modificarse.
                            </small>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="nombre" class="form-label">
                                Nombre
                            </label>

                            <input asp-for="nombre"
                                   class="form-control bg-light"
                                   readonly />

                            <small class="text-muted">
                                El nombre no puede modificarse.
                            </small>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="telefono" class="form-label">
                                Teléfono
                            </label>

                            <input asp-for="telefono"
                                   class="form-control" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="email" class="form-label">
                                Correo Electrónico
                            </label>

                            <input asp-for="email"
                                   class="form-control" />

                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="puesto" class="form-label">
                            Puesto
                        </label>

                        <input asp-for="puesto"
                               class="form-control" />

                    </div>

                    <div class="d-flex justify-content-between mt-4">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-clinica">
                            Guardar Cambios
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>