@model List<Clinica.Models.ClientesModel>

<div class="container mt-4">

    <div class="card-clinica">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2 class="titulo-clinica mb-0">
                Clientes
            </h2>

            <a asp-controller="Clientes"
               asp-action="Crear"
               class="btn btn-clinica">
                Nuevo Cliente
            </a>

        </div>

        @if (ViewBag.Respuesta != null)
        {
            <div class="alert alert-info">
                @ViewBag.Respuesta
            </div>
        }

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-primary">

                    <tr>
                        <th>Identificación</th>
                        <th>Nacionalidad</th>
                        <th>Nombre</th>
                        <th>1er Apellido</th>
                        <th>2do Apellido</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th class="text-center">Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var cliente in Model)
                    {
                        <tr>

                            <td>@cliente.identificacion</td>
                            <td>@cliente.nacionalidad</td>
                            <td>@cliente.nombre</td>
                            <td>@cliente.primerApellido</td>
                            <td>@cliente.segundoApellido</td>
                            <td>@cliente.telefono</td>
                            <td>@cliente.email</td>

                            <td>

                                <div class="d-flex gap-2 justify-content-center">

                                    <a asp-action="Editar"
                                       asp-route-id="@cliente.identificacion"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>

                                    <a asp-action="Eliminar"
                                       asp-route-id="@cliente.identificacion"
                                       class="btn btn-sm btn-outline-danger">
                                        Eliminar
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="mt-3">

            <a asp-controller="Menu"
               asp-action="Index"
               class="btn btn-secondary">
                Atrás
            </a>

        </div>

    </div>

</div>