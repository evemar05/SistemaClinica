@model Clinica.Models.EspecialidadModel

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card-clinica">

                <h2 class="titulo-clinica text-center mb-4">
                    Nueva Especialidad
                </h2>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <form method="post">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="nombre"
                               class="form-label">
                            Nombre
                        </label>

                        <input asp-for="nombre"
                               class="form-control" />

                        <span asp-validation-for="nombre"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="descripcion"
                               class="form-label">
                            Descripción
                        </label>

                        <textarea asp-for="descripcion"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="descripcion"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-clinica">
                            Guardar Especialidad
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}