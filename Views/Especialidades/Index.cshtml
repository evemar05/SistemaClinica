@model List<Clinica.Models.EspecialidadModel>

<div class="container mt-4">

    <div class="card-clinica">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2 class="titulo-clinica mb-0">
                Especialidades
            </h2>

            <div>

                <a asp-action="Crear"
                   class="btn btn-clinica">
                    Nueva Especialidad
                </a>

                <a asp-controller="Menu"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Atrás
                </a>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-primary">

                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th class="text-center">Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var especialidad in Model)
                    {
                        <tr>

                            <td>
                                <strong>@especialidad.nombre</strong>
                            </td>

                            <td>
                                @especialidad.descripcion
                            </td>

                            <td>

                                <div class="d-flex gap-2 justify-content-center">

                                    <a asp-action="Editar"
                                       asp-route-id="@especialidad.nombre"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>

                                    <a asp-action="Eliminar"
                                       asp-route-id="@especialidad.nombre"
                                       class="btn btn-sm btn-outline-danger">
                                        Eliminar
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>