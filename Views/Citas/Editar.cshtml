@model Clinica.Models.CitaModel

<h2>Editar Cita</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form method="post">
    <input asp-for="idCita" type="hidden" />

    <div class="mb-3">
        <label>Cliente</label>
        <input value="@Model.idCliente" readonly class="form-control" />
    </div>

    <div class="mb-3">
        <label>Médico</label>
        <input value="@Model.idMedico" readonly class="form-control" />
    </div>

    <div class="mb-3">
        <label>Fecha (AAAA-MM-DD)</label>
        <input asp-for="fecha" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Hora Inicio (HH:MM)</label>
        <input asp-for="horaInicio" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Hora Fin (HH:MM)</label>
        <input asp-for="horaFin" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

<p><small>Solo se puede modificar con al menos 2 días de anticipación a la fecha de la cita.</small></p>
