@model List<Clinica.Models.MedicoModel>

<h2>Horario de Especialista por Semana</h2>

<form method="get">
    <label>Buscar por especialidad, nombre o identificación del médico</label>
    <input type="text" name="criterio" value="@Context.Request.Query["criterio"]" class="form-control" />
    <br />
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

<hr />

@if (Model.Count > 0)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Identificación</th>
                <th>Nombre</th>
                <th>Especialidad</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var medico in Model)
            {
                <tr>
                    <td>@medico.identificacion</td>
                    <td>@medico.nombre</td>
                    <td>@medico.especialidad</td>
                    <td>
                        <a asp-action="Semana" asp-route-idMedico="@medico.identificacion">Ver horario semanal</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Menu" asp-action="Index" class="btn btn-secondary">Atrás</a>
