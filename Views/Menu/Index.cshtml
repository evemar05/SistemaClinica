@{
    var rol = Context.Session.GetString("rol");
    var usuario = Context.Session.GetString("usuario");
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 19 ? "Buenas tardes" : "Buenas noches";
}

<style>
    .clinica-shell {
        --tinta: #16302B;
        --fondo: #F5F7F5;
        --panel: #0F2B26;
        --panel-linea: #244138;
        --panel-texto: #DCEAE4;
        --panel-texto-tenue: #85A79C;
        --coral: #FF8B6B;
        --menta: #6FCF97;
        --borde: #E1E8E3;
        --fuente-display: 'Space Grotesk', 'Segoe UI', sans-serif;
        --fuente-cuerpo: 'Inter', 'Segoe UI', sans-serif;
        --fuente-mono: 'JetBrains Mono', 'Consolas', monospace;
        display: flex;
        min-height: 100vh;
        background: var(--fondo);
        color: var(--tinta);
        font-family: var(--fuente-cuerpo);
    }

    @@media (prefers-reduced-motion: no-preference) {
        .clinica-shell .pulso-linea path {
            stroke-dasharray: 300;
            stroke-dashoffset: 300;
            animation: dibujar-pulso 1.4s ease-out 0.2s forwards;
        }
    }

    @@keyframes dibujar-pulso {
        to {
            stroke-dashoffset: 0;
        }
    }

    .clinica-nav {
        width: 272px;
        flex-shrink: 0;
        background: var(--panel);
        color: var(--panel-texto);
        padding: 32px 20px;
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 0;
        height: 100vh;
    }

    .clinica-marca {
        font-family: var(--fuente-display);
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        margin: 0;
        display: flex;
        align-items: baseline;
        gap: 8px;
    }

        .clinica-marca span {
            font-family: var(--fuente-mono);
            font-size: 0.62rem;
            font-weight: 500;
            color: var(--coral);
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

    .pulso-linea {
        width: 100%;
        height: 26px;
        margin: 14px 0 22px;
        display: block;
    }

    .cuenta {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--panel-linea);
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 26px;
    }

    .cuenta-rol {
        display: inline-block;
        font-family: var(--fuente-mono);
        font-size: 0.63rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #0F2B26;
        background: var(--menta);
        padding: 3px 9px;
        border-radius: 999px;
        margin-bottom: 8px;
    }

    .cuenta-usuario {
        font-family: var(--fuente-display);
        font-size: 1rem;
        font-weight: 500;
        color: #fff;
    }

    .nav-grupo {
        margin-bottom: 22px;
    }

    .nav-eyebrow {
        font-family: var(--fuente-mono);
        font-size: 0.62rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--panel-texto-tenue);
        margin: 0 0 8px 4px;
    }

    .nav-lista {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .nav-link {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 9px 12px;
        border-radius: 8px;
        color: var(--panel-texto);
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 450;
        border: 1px solid transparent;
        transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

        .nav-link svg {
            flex-shrink: 0;
            opacity: 0.8;
        }

        .nav-link:hover {
            background: rgba(255, 139, 107, 0.1);
            border-color: rgba(255, 139, 107, 0.35);
            color: #fff;
            transform: translateX(2px);
        }

        .nav-link:focus-visible {
            outline: 2px solid var(--coral);
            outline-offset: 2px;
        }

    .clinica-nav .salir-bloque {
        margin-top: auto;
        padding-top: 18px;
        border-top: 1px solid var(--panel-linea);
    }

    .btn-salir {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 11px;
        border-radius: 8px;
        background: transparent;
        border: 1px solid var(--panel-linea);
        color: var(--panel-texto-tenue);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 500;
        transition: all 0.15s ease;
    }

        .btn-salir:hover {
            border-color: var(--coral);
            color: var(--coral);
        }


    .clinica-contenido {
        flex: 1;
        padding: 56px 48px;
    }

    .bienvenida-eyebrow {
        font-family: var(--fuente-mono);
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--coral);
        margin: 0 0 10px;
    }

    .bienvenida-titulo {
        font-family: var(--fuente-display);
        font-size: 2.1rem;
        font-weight: 600;
        letter-spacing: -0.015em;
        margin: 0 0 12px;
        color: var(--tinta);
    }

    .bienvenida-texto {
        max-width: 46ch;
        color: #4C6B63;
        font-size: 1rem;
        line-height: 1.6;
        margin: 0;
    }

    @@media (max-width: 860px) {
        .clinica-shell {
            flex-direction: column;
        }

        .clinica-nav {
            width: 100%;
            height: auto;
            position: relative;
            padding: 24px 20px;
        }

        .clinica-contenido {
            padding: 36px 24px;
        }
    }
</style>

<div class="clinica-shell">

    <nav class="clinica-nav">

        <p class="clinica-marca">Clínica <span>Sistema&nbsp;Interno</span></p>

        <svg class="pulso-linea" viewBox="0 0 240 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M0 13 H70 L82 3 L96 23 L108 13 H240" stroke="#FF8B6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>

        <div class="cuenta">
            <span class="cuenta-rol">@rol</span>
            <div class="cuenta-usuario">@usuario</div>
        </div>

        @if (rol == "empleado")
        {
            <div class="nav-grupo">
                <p class="nav-eyebrow">Registros</p>
                <ul class="nav-lista">
                    <li>
                        <a asp-controller="Clientes" asp-action="Index" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="5.2" r="2.6" /><path d="M2.5 14c.6-3 2.7-4.6 5.5-4.6s4.9 1.6 5.5 4.6" /></svg>
                            Clientes
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Medicos" asp-action="Index" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 2v4.2a2 2 0 0 0 4 0V2" /><path d="M6 4H4.5M10 4h1.5" /><path d="M8 8.2v2.3c0 2-1.3 3.5-3.5 3.5S1 12.5 1 10.5" transform="translate(3 0)" /><circle cx="12.3" cy="12" r="1.6" /></svg>
                            Médicos
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Especialidades" asp-action="Index" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2.5" width="12" height="11" rx="1.5" /><path d="M5 6h6M5 8.5h6M5 11h3.5" /></svg>
                            Especialidades
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Empleados" asp-action="Index" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="5.5" cy="5" r="2.1" /><circle cx="11" cy="6" r="1.7" /><path d="M1.5 13.2c.5-2.5 2.1-3.8 4-3.8s3.5 1.3 4 3.8" /><path d="M9.6 9.6c1.5.1 2.6 1.2 3 3.1" /></svg>
                            Empleados
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-grupo">
                <p class="nav-eyebrow">Agenda</p>
                <ul class="nav-lista">
                    <li>
                        <a asp-controller="Horarios" asp-action="Index" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="8.5" r="5.5" /><path d="M8 5.3V8.5l2.3 1.4" /><path d="M6 1.5h4" /></svg>
                            Horarios
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Citas" asp-action="Index" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="3" width="12" height="11" rx="1.5" /><path d="M2 6.3h12M5 1.5v2.4M11 1.5v2.4" /><path d="M5.3 9.3h1.4M5.3 11.6h1.4M8 9.3h1.4M8 11.6h1.4" /></svg>
                            Citas
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Citas" asp-action="SemanaBuscar" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1.5 8.5h5.5l1.7-3.4 1.8 6.8 1.5-3.4h2.5" /></svg>
                            Horario por semana
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-grupo">
                <p class="nav-eyebrow">Pagos</p>
                <ul class="nav-lista">
                    <li>
                        <a asp-controller="Facturacion" asp-action="Index" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 1.5h8v13l-2-1.3-2 1.3-2-1.3-2 1.3z" /><path d="M6 5h4M6 7.6h4M6 10.2h2.5" /></svg>
                            Facturación
                        </a>
                    </li>
                </ul>
            </div>
        }
        else if (rol == "cliente")
        {
            <div class="nav-grupo">
                <p class="nav-eyebrow">Mi cuenta</p>
                <ul class="nav-lista">
                    <li>
                        <a asp-controller="Clientes" asp-action="Editar" asp-route-id="@Context.Session.GetString("identificacion")" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="5.2" r="2.6" /><path d="M2.5 14c.6-3 2.7-4.6 5.5-4.6s4.9 1.6 5.5 4.6" /></svg>
                            Mis datos
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-grupo">
                <p class="nav-eyebrow">Citas</p>
                <ul class="nav-lista">
                    <li>
                        <a asp-controller="Citas" asp-action="Especialidades" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2.5" width="12" height="11" rx="1.5" /><path d="M5 6h6M5 8.5h6M5 11h3.5" /></svg>
                            Médicos por especialidad
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Citas" asp-action="Agendar" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="3" width="12" height="11" rx="1.5" /><path d="M2 6.3h12M5 1.5v2.4M11 1.5v2.4M8 9.3v3M6.5 10.8h3" /></svg>
                            Agendar cita
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Citas" asp-action="MisCitas" class="nav-link">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="8.5" r="5.5" /><path d="M8 5.3V8.5l2.3 1.4" /></svg>
                            Mis citas
                        </a>
                    </li>
                </ul>
            </div>
        }

        <div class="salir-bloque">
            <a asp-controller="Login" asp-action="Salir" class="btn-salir">
                <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 2H3.5A1.5 1.5 0 0 0 2 3.5v9A1.5 1.5 0 0 0 3.5 14H6" /><path d="M10.5 11.5 14 8l-3.5-3.5M14 8H6" /></svg>
                Cerrar sesión
            </a>
        </div>

    </nav>

    <main class="clinica-contenido">
        <p class="bienvenida-eyebrow">Panel principal</p>
        <h1 class="bienvenida-titulo">@saludo, @usuario</h1>
        <p class="bienvenida-texto">
    </main>

</div>
