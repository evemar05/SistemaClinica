@{
    ViewData["Title"] = "Buscar Cita a Facturar";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card-clinica">

                <h2 class="titulo-clinica text-center mb-4">
                    Facturar una Cita
                </h2>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <form method="post">

                    <div class="mb-4">

                        <label class="form-label">
                            Número de Cita
                        </label>

                        <input type="number"
                               name="idCita"
                               class="form-control"
                               required />

                        <small class="text-muted">
                            Ingrese el número de la cita que desea facturar.
                        </small>

                    </div>

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Atrás
                        </a>

                        <button type="submit"
                                class="btn btn-clinica">
                            Buscar
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>